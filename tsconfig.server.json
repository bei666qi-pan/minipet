{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src/server",
    "outDir": "dist-server",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src/server/**/*.ts"]
}
